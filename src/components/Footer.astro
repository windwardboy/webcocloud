---
import { nav, site, websiteCategories } from "../config/site";
import { clientAreaHref, hostingLoginHref, webmailHref } from "../lib/links";
import Logo from "./Logo.astro";

const hasLegal = site.legalName.length > 0;
const legalParts = [
  site.legalName,
  site.companyNumber ? `Company number ${site.companyNumber}` : "",
  site.registeredOffice,
].filter(Boolean);
const serviceLinks = nav.filter((item) => item.href !== "/");
const webmail = webmailHref();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <Logo />
      <p>Hosting, domains, email and support for websites built by Webco Media.</p>
      {hasLegal ? <p class="legal">{legalParts.join(" · ")}</p> : null}
    </div>
    <div>
      <p class="footer-label">Services</p>
      <ul class="footer-nav">
        {
          serviceLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Industries</p>
      <ul class="footer-nav">
        {
          websiteCategories.map((category) => (
            <li>
              <a href={category.href}>{category.footerLabel}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Customers</p>
      <ul class="footer-nav">
        <li><a href="/support/">Support</a></li>
        <li><a href={clientAreaHref()}>Client area</a></li>
        {
          webmail && (
            <li>
              <a href={webmail} rel="noopener noreferrer">
                Webmail
              </a>
            </li>
          )
        }
        {
          hostingLoginHref() && (
            <li>
              <a class="footer-aside" href={hostingLoginHref()} rel="noopener noreferrer">
                Hosting login
              </a>
            </li>
          )
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Legal</p>
      <ul class="footer-nav">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/cookies/">Cookies</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-meta">
    <p>© {year} {site.legalName || site.name}</p>
    <p>
      Website design by{" "}
      <a href={site.webcoMediaUrl || "https://webcomedia.net"} rel="noopener noreferrer">Webco Media</a>
    </p>
  </div>
</footer>
