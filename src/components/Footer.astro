---
import { nav, site } from "../config/site";
import { clientLoginHref } from "../lib/links";

const hasLegal = site.legalName.length > 0;
const legalParts = [site.legalName, site.companyNumber, site.registeredOffice].filter(Boolean);
const serviceLinks = nav.filter((item) => item.href !== "/");
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p>Hosting, domains, email and support for websites built by Webco Media.</p>
      {
        site.webcoMediaUrl ? (
          <p>
            <a href={site.webcoMediaUrl}>Webco Media</a>
          </p>
        ) : null
      }
      {hasLegal ? <p class="legal">{legalParts.join(" · ")}</p> : null}
    </div>
    <div>
      <p class="footer-label">Services</p>
      <ul class="footer-nav">
        {
          serviceLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="footer-label">Customers</p>
      <ul class="footer-nav">
        <li><a href="/support/">Support</a></li>
        <li><a href={clientLoginHref()}>Client login</a></li>
      </ul>
    </div>
  </div>
</footer>
