---
import { webcoMedia } from "../config/site";

// The logo stays on this landing page. It is deliberately not a link to the Webco Cloud homepage.
const landingPath = "/web-design/hgv-driver-training/";
---

<header class="lp-header">
  <div class="wrap lp-header-inner">
    <a class="logo" href={landingPath} aria-label="Webco Cloud — back to the top of this page">
      <img src="/images/logo-webco-cloud.png" width="1024" height="426" alt="Webco Cloud" decoding="async" />
    </a>
    <a class="lp-call" href={webcoMedia.phoneHref}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M5 4h3.5l1.6 4.2-2.2 1.4a11 11 0 0 0 6.5 6.5l1.4-2.2L20 15.5V19a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"></path>
      </svg>
      <span class="lp-call-text">
        <span class="lp-call-label">Call Webco Media</span>
        <span class="lp-call-number">{webcoMedia.phone}</span>
      </span>
    </a>
  </div>
</header>
