---
/**
 * Small inline icon set for the landing page. Decorative: always aria-hidden.
 * Paths are 24x24, drawn with a 1.8 stroke.
 */
interface Props {
  name: "phone" | "mail" | "globe" | "pin" | "check" | "arrow" | "chat" | "dash" | "external" | "shield";
  size?: number;
}

const { name, size = 20 } = Astro.props;

const paths: Record<Props["name"], string[]> = {
  phone: ["M5 4h3.5l1.6 4.2-2.2 1.4a11 11 0 0 0 6.5 6.5l1.4-2.2L20 15.5V19a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"],
  mail: ["M3.5 6.5h17v11h-17z", "m4 7.5 8 6 8-6"],
  globe: ["M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z", "M3.5 12h17", "M12 3c2.6 2.5 3.9 5.5 3.9 9s-1.3 6.5-3.9 9c-2.6-2.5-3.9-5.5-3.9-9S9.400 5.500 12 3Z"],
  pin: ["M12 21s-6.5-5.6-6.5-11a6.500 6.500 0 0 1 13 0c0 5.400-6.500 11-6.500 11Z", "M12 12.200a2.200 2.200 0 1 0 0-4.400 2.200 2.200 0 0 0 0 4.400Z"],
  check: ["m5 12.500 4.500 4.500L19 7.500"],
  arrow: ["M5 12h14", "m13 6 6 6-6 6"],
  chat: ["M4 5.500h16v10.500H9.500L5 20v-4H4z"],
  dash: ["M6 12h12"],
  external: ["M14 4h6v6", "M20 4 10.500 13.500", "M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"],
  shield: ["M12 3.500 5 6v5.500c0 4.300 2.800 7.500 7 9 4.200-1.500 7-4.700 7-9V6l-7-2.500Z", "m9 12 2.200 2.200L15.200 10"],
};
---

<svg
  class="lp-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
