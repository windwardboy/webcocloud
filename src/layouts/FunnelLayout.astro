---
import FunnelChrome from "../components/FunnelChrome.astro";
import { site } from "../config/site";
import { canonicalUrl } from "../lib/links";
import interUrl from "../fonts/inter-latin-wght-normal.woff2?url";
import frauncesUrl from "../fonts/fraunces-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  step?: number;
  phase?: "flow" | "payment";
  track?: "wide" | "narrow";
}

const { title, description, noindex = false, step = 1, phase = "flow", track = "wide" } = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const canonical = canonicalUrl(Astro.url.pathname);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0c6b62" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class:list={["funnel", track === "narrow" ? "funnel-track-narrow" : "funnel-track-wide"]}>
    <a class="skip" href="#content">Skip to content</a>
    <FunnelChrome step={step} phase={phase} />
    <main id="content">
      <slot />
    </main>
    <script is:inline>
      const fieldSelector =
        "input:not([type=radio]):not([type=checkbox]):not([type=hidden]):not([type=button]):not([type=submit]), textarea, select";

      function isField(node) {
        return node instanceof HTMLElement && node.matches(fieldSelector);
      }

      function coveredBottom(field) {
        let bottom = field.getBoundingClientRect().bottom;
        const group = field.closest(".domain-field, fieldset");
        if (group) {
          const error = group.querySelector(".field-error");
          if (error && error.textContent.trim()) bottom = Math.max(bottom, error.getBoundingClientRect().bottom);
        }
        const form = field.closest("form");
        const result = form && form.nextElementSibling;
        if (result && result.classList.contains("domain-result") && result.textContent.trim() && !result.hidden) {
          bottom = Math.max(bottom, result.getBoundingClientRect().bottom);
        }
        return bottom;
      }

      function reveal(field) {
        const viewport = window.visualViewport;
        const topLimit = (viewport ? viewport.offsetTop : 0) + 76;
        const bottomLimit = (viewport ? viewport.offsetTop + viewport.height : window.innerHeight) - 12;
        const top = field.getBoundingClientRect().top;
        const bottom = coveredBottom(field);
        if (bottom > bottomLimit) window.scrollBy(0, bottom - bottomLimit + 10);
        else if (top < topLimit) window.scrollBy(0, top - topLimit);
      }

      const narrow = window.matchMedia("(max-width: 47.99rem)");

      function keyboardOpen() {
        const viewport = window.visualViewport;
        if (!viewport) return isField(document.activeElement);
        return window.innerHeight - viewport.height - viewport.offsetTop > 80;
      }

      function syncTyping() {
        const typing = narrow.matches && isField(document.activeElement) && keyboardOpen();
        document.body.classList.toggle("funnel-keyboard", typing);
        document.querySelectorAll(".funnel-dock").forEach((dock) => {
          dock.toggleAttribute("inert", typing);
        });
      }

      let keyboardTimer = 0;
      document.addEventListener("focusin", (event) => {
        if (!isField(event.target)) return;
        window.clearTimeout(keyboardTimer);
        keyboardTimer = window.setTimeout(() => {
          syncTyping();
          if (document.body.classList.contains("funnel-keyboard")) reveal(event.target);
        }, 50);
      });
      document.addEventListener("focusout", (event) => {
        if (!isField(event.target)) return;
        window.clearTimeout(keyboardTimer);
        keyboardTimer = window.setTimeout(syncTyping, 80);
      });
      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", () => {
          const active = document.activeElement;
          syncTyping();
          if (document.body.classList.contains("funnel-keyboard") && isField(active)) reveal(active);
        });
      }
    </script>
  </body>
</html>
