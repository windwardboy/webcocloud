---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="That page is not on the Webco Cloud website."
  noindex
>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>That page is not here</h1>
    <p class="lede">The address may be mistyped, or the page may have moved.</p>
    <div class="actions">
      <a class="button" href="/">Back to the homepage</a>
      <a class="button button-quiet" href="/support/">Support</a>
    </div>
  </section>
</BaseLayout>
