---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { clientAreaHref, hostingLoginHref } from "../lib/links";

const description =
  "Domain registration, connection and renewal for websites and email looked after by Webco Cloud.";
---

<BaseLayout title="Domains" description={description}>
  <PageHero eyebrow="Domains" title="Your domain name, kept with the website">
    <p>
      The domain is the address of the website and the business email. Webco Cloud registers it, connects it and renews it with the rest of the service.
    </p>
  </PageHero>

  <section class="section" aria-labelledby="domain-search-heading">
    <div class="wrap">
      <div class="card domain-search">
        <h2 id="domain-search-heading">Check a domain</h2>
        <p>See whether a name such as example.co.uk can be registered. This does not register it.</p>
        <form id="domain-search" class="domain-form">
          <div class="domain-field">
            <label for="domain">Domain name</label>
            <input
              id="domain"
              name="domain"
              type="text"
              inputmode="url"
              autocomplete="off"
              spellcheck="false"
              maxlength="253"
              placeholder="example.co.uk"
              required
            />
          </div>
          <button class="button" type="submit">Check availability</button>
        </form>
        <div id="domain-search-result" class="domain-result" role="status" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="domain-work-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="domain-work-heading">What we take care of</h2>
        <p class="section-intro">The price is confirmed for the domain name you choose.</p>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>Registration</h3>
          <p>A new domain can be registered with the website.</p>
        </li>
        <li class="card">
          <h3>An existing domain</h3>
          <p>A domain you already own can be connected to the website and email.</p>
        </li>
        <li class="card">
          <h3>Renewal</h3>
          <p>Renewals are billed with your other Webco Cloud services.</p>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title="Keep the domain with the website"
    text="Registration, connection and renewal stay with your Webco Cloud services."
  >
    <a class="button" href={clientAreaHref()}>Client area</a>
    <a class="button button-quiet" href={hostingLoginHref()} rel="noopener noreferrer">Hosting login</a>
    <a class="button button-quiet" href="/support/">Get support</a>
  </CtaBand>
</BaseLayout>

<script is:inline>
  const form = document.querySelector("#domain-search");
  const result = document.querySelector("#domain-search-result");
  const button = form?.querySelector("button");

  function copyDomain(domain, trigger) {
    const done = function () {
      trigger.setAttribute("data-copied", "true");
      trigger.setAttribute("aria-label", "Copied " + domain);
      window.clearTimeout(trigger._copyTimer);
      trigger._copyTimer = window.setTimeout(function () {
        trigger.removeAttribute("data-copied");
        trigger.setAttribute("aria-label", "Copy " + domain);
      }, 1400);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(domain).then(done).catch(function () {
        fallbackCopy(domain, done);
      });
      return;
    }

    fallbackCopy(domain, done);
  }

  function fallbackCopy(domain, done) {
    const input = document.createElement("input");
    input.value = domain;
    input.setAttribute("readonly", "");
    input.style.position = "fixed";
    input.style.opacity = "0";
    document.body.appendChild(input);
    input.select();
    try {
      document.execCommand("copy");
      done();
    } catch (_error) {
      /* ignore */
    }
    document.body.removeChild(input);
  }

  function domainCopyButton(domain) {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "domain-copy";
    btn.setAttribute("aria-label", "Copy " + domain);
    btn.title = "Click to copy";
    btn.textContent = domain;
    btn.addEventListener("click", function () {
      copyDomain(domain, btn);
    });
    return btn;
  }

  function showMessage(state, message) {
    if (!result) return;
    result.dataset.state = state;
    const p = document.createElement("p");
    p.className = "domain-result-primary";
    p.textContent = message;
    result.replaceChildren(p);
  }

  function showSearchResult(data) {
    if (!result) return;

    const primary = document.createElement("p");
    primary.className = "domain-result-primary";
    if (data.status === "available") {
      result.dataset.state = "available";
      primary.append(domainCopyButton(data.domain), document.createTextNode(" is available."));
    } else {
      result.dataset.state = "unavailable";
      primary.append(domainCopyButton(data.domain), document.createTextNode(" is not available."));
    }

    const nodes = [primary];
    const alternatives = Array.isArray(data.alternatives) ? data.alternatives : [];
    if (alternatives.length > 0) {
      const heading = document.createElement("p");
      heading.className = "domain-alt-heading";
      heading.textContent = "Other popular UK endings";

      const list = document.createElement("ul");
      list.className = "domain-alt-list";

      alternatives.forEach(function (item) {
        if (!item || typeof item.domain !== "string") return;
        if (item.status !== "available" && item.status !== "unavailable") return;

        const li = document.createElement("li");
        li.dataset.state = item.status;

        const name = domainCopyButton(item.domain);
        name.classList.add("domain-alt-name");

        const badge = document.createElement("span");
        badge.className = "domain-alt-badge";
        badge.textContent = item.status === "available" ? "Available" : "Not available";

        li.append(name, badge);
        list.appendChild(li);
      });

      if (list.childNodes.length > 0) {
        nodes.push(heading, list);
      }
    }

    result.replaceChildren.apply(result, nodes);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const domain = String(new FormData(form).get("domain") || "").trim();
    if (!domain || !button) return;

    button.disabled = true;
    showMessage("", "Checking…");

    try {
      const response = await fetch("/domain-search.php", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new URLSearchParams({ domain }),
      });
      const data = await response.json();
      if (data.status === "available" || data.status === "unavailable") {
        showSearchResult(data);
      } else if (response.status === 400) {
        showMessage("error", "Enter a domain such as example.co.uk.");
      } else {
        showMessage("error", "We could not check that domain just now.");
      }
    } catch {
      showMessage("error", "We could not check that domain just now.");
    } finally {
      button.disabled = false;
    }
  });
</script>
