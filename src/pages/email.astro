---
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "Professional business email on your own domain, with an agreed number of mailboxes set up by Webco Cloud.";
---

<BaseLayout title="Email" description={description}>
  <section class="hero">
    <p class="eyebrow">Email</p>
    <h1>Business email on your own domain</h1>
    <p class="lede">
      Professional email addresses are available with your website. Each mailbox has 10GB of storage. We set up an agreed number of mailboxes at the start and send the settings you need.
    </p>
  </section>

  <section class="section" aria-labelledby="email-scope-heading">
    <h2 id="email-scope-heading">What is included</h2>
    <ul class="plain-list">
      <li>
        <h3>Addresses on your domain</h3>
        <p>Mail uses the same domain as the website, such as a name at your business address.</p>
      </li>
      <li>
        <h3>Initial setup</h3>
        <p>A limited number of mailboxes are created at launch, with the configuration details to add them to your mail app.</p>
      </li>
      <li>
        <h3>A clear boundary</h3>
        <p>
          Ongoing troubleshooting of a mail app on a particular phone or computer is separate from website support. Extra mailboxes beyond the agreed setup are arranged separately.
        </p>
      </li>
    </ul>
  </section>
</BaseLayout>
