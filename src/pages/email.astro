---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { clientAreaHref, hostingLoginHref, webmailHref } from "../lib/links";

const description =
  "Professional business email on your own domain, with an agreed number of mailboxes set up by Webco Cloud.";
const webmail = webmailHref();
---

<BaseLayout title="Email" description={description}>
  <PageHero eyebrow="Email" title="Business email on your own domain">
    <p>
      Professional addresses come with your website. Each mailbox has 10GB of storage. We set up the agreed mailboxes and send the settings you need.
    </p>
    {
      webmail && (
        <div class="actions">
          <a class="button" href={webmail} rel="noopener noreferrer">
            Open webmail
          </a>
        </div>
      )
    }
  </PageHero>

  <section class="section" aria-labelledby="email-scope-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="email-scope-heading">What is included</h2>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>Addresses on your domain</h3>
          <p>Mail uses the same domain as the website, such as a name at your business address.</p>
        </li>
        <li class="card">
          <h3>Mailbox setup</h3>
          <p>The agreed mailboxes are created at the start, with the settings to add them to your mail app.</p>
        </li>
        <li class="card">
          <h3>Webmail</h3>
          <p>
            Check mail in the browser when you need to.
            {
              webmail && (
                <>
                  {" "}
                  <a href={webmail} rel="noopener noreferrer">
                    Open webmail
                  </a>
                  .
                </>
              )
            }
          </p>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title="Email that uses your domain"
    text="Open webmail to check your inbox. The client area is for your website project. Hosting login is for an existing hosting account."
  >
    {
      webmail && (
        <a class="button" href={webmail} rel="noopener noreferrer">
          Open webmail
        </a>
      )
    }
    <a class="button button-quiet" href={clientAreaHref()}>Client area</a>
    <a class="button button-quiet" href={hostingLoginHref()} rel="noopener noreferrer">Hosting login</a>
  </CtaBand>
</BaseLayout>
