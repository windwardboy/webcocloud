---
import BaseLayout from "../layouts/BaseLayout.astro";
import { commercial } from "../config/site";

const description =
  "Website hosting for sites built by Webco Media, including SSL, a simple renewal, and optional Managed Care.";
---

<BaseLayout title="Hosting" description={description}>
  <section class="hero">
    <p class="eyebrow">Hosting</p>
    <h1>Website hosting, looked after for you</h1>
    <p class="lede">
      Webco Cloud hosts the website so it stays available. The technical work sits behind a simple service: the site, the domain, email and support in one relationship.
    </p>
  </section>

  <section class="section" aria-labelledby="included-heading">
    <h2 id="included-heading">What hosting covers</h2>
    <ul class="plain-list">
      <li>
        <h3>The live website</h3>
        <p>The site Webco Media built is published and kept online.</p>
      </li>
      <li>
        <h3>SSL</h3>
        <p>The site is served over HTTPS.</p>
      </li>
      <li>
        <h3>The first year</h3>
        <p>
          When Webco Media builds the website, the first year of hosting is part of that work, along with domain setup where a domain is included.
        </p>
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="after-heading">
    <h2 id="after-heading">After the first year</h2>
    <p>Hosting can continue in either of these ways.</p>
    <div class="choices">
      <article class="choice">
        <h3>{commercial.hostingRenewal.name}</h3>
        <p class="price">{commercial.hostingRenewal.price}</p>
        <p>{commercial.hostingRenewal.summary}</p>
      </article>
      <article class="choice" id="managed-care">
        <h3>{commercial.managedCare.name}</h3>
        <p class="price">{commercial.managedCare.price}</p>
        <p>{commercial.managedCare.summary}</p>
        <p>{commercial.managedCare.allowance}</p>
      </article>
    </div>
    <p class="note">{commercial.reviewNote}</p>
  </section>
</BaseLayout>
