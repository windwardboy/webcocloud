---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { commercial } from "../config/site";
import { clientLoginHref } from "../lib/links";

const description =
  "Website hosting for sites built by Webco Media, including SSL, a simple renewal, and optional Managed Care.";
---

<BaseLayout title="Hosting" description={description}>
  <PageHero eyebrow="Hosting" title="Website hosting, looked after for you">
    <p>
      Your website stays available, with SSL, alongside the domain, email and support.
    </p>
  </PageHero>

  <section class="section" aria-labelledby="included-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="included-heading">What hosting covers</h2>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>The live website</h3>
          <p>The site Webco Media built is published and kept online.</p>
        </li>
        <li class="card">
          <h3>SSL</h3>
          <p>The site is served over HTTPS.</p>
        </li>
        <li class="card">
          <h3>The first year</h3>
          <p>
            The first year of hosting is included when Webco Media builds the website, with domain setup when a domain is part of that work.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="after-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="after-heading">After the first year</h2>
        <p class="section-intro">
          Continue with yearly hosting, or choose Managed Care when you want routine website updates included.
        </p>
      </div>
      <div class="cards cards-2">
        <article class="card">
          <h3>{commercial.hostingRenewal.name}</h3>
          <p class="price">{commercial.hostingRenewal.price}</p>
          <p>{commercial.hostingRenewal.summary}</p>
        </article>
        <article class="card plan-featured" id="managed-care">
          <h3>{commercial.managedCare.name}</h3>
          <p class="price">{commercial.managedCare.essential}</p>
          <p>Essential websites</p>
          <p class="price">{commercial.managedCare.professional}</p>
          <p>Professional websites</p>
          <p>{commercial.managedCare.summary}</p>
          <p>{commercial.managedCare.allowance}</p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand
    title="Manage hosting from your customer area"
    text="Sign in to look after the service, or contact support about renewal and Managed Care."
  >
    <a class="button" href={clientLoginHref()}>Client login</a>
    <a class="button button-quiet" href="/support/">Get support</a>
  </CtaBand>
</BaseLayout>
