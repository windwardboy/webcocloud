---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../config/site";
import { clientAreaHref, hostingLoginHref } from "../lib/links";
---

<BaseLayout title={site.name} description={site.description}>
  <PageHero eyebrow="The platform behind Webco websites" title={site.positioning}>
    <p>
      Hosting, domains, business email, renewals and support for websites built by Webco Media.
    </p>
    <div class="actions">
      <a class="button" href={clientAreaHref()}>Client area</a>
      <a class="button button-quiet" href="/support/">Get support</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What Webco Cloud looks after</h2>
        <p class="section-intro">One service for the website once it has been built.</p>
      </div>
      <ul class="cards cards-4">
        <li>
          <a class="card card-link" href="/hosting/">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                <path d="M3 8h18"></path>
              </svg>
            </span>
            <h3>Hosting</h3>
            <p>The website stays online, with SSL, on hosting managed for you.</p>
            <span class="card-action">View hosting</span>
          </a>
        </li>
        <li>
          <a class="card card-link" href="/domains/">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="12" cy="12" r="8"></circle>
                <path d="M4 12h16M12 4c2.2 2.4 2.2 13.6 0 16M12 4c-2.2 2.4-2.2 13.6 0 16"></path>
              </svg>
            </span>
            <h3>Domains</h3>
            <p>The domain name is registered, connected and renewed with the website.</p>
            <span class="card-action">View domains</span>
          </a>
        </li>
        <li>
          <a class="card card-link" href="/email/">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="M4 7l8 6 8-6"></path>
              </svg>
            </span>
            <h3>Email</h3>
            <p>Professional email addresses on your own domain, set up with the settings you need.</p>
            <span class="card-action">View email</span>
          </a>
        </li>
        <li>
          <a class="card card-link" href="/support/">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M6 16.5V8.8A6 6 0 0 1 18 8.8V14a2 2 0 0 1-2 2H9.2L6 18.2V16.5z"></path>
              </svg>
            </span>
            <h3>Support</h3>
            <p>Help with the website, the domain and the email we set up for you.</p>
            <span class="card-action">Get support</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="who-heading">
    <div class="wrap">
      <div class="panel">
        <div>
          <p class="eyebrow">Customers</p>
          <h2 id="who-heading">Who it is for</h2>
        </div>
        <div>
          <p>
            Small and medium UK businesses with a website built by Webco Media, including HGV and transport training providers introduced through LearnHGV.
          </p>
          <p>The website, domain, email and support sit together, so there is one place to go.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="roles-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="roles-heading">Who looks after what</h2>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>LearnHGV</h3>
          <p>
            Introduces website services to HGV and transport training providers. Webco services do not affect LearnHGV ranking, verification or how a provider appears in the directory.
          </p>
        </li>
        <li class="card">
          <h3>Webco Media</h3>
          <p>Designs and builds the website.</p>
          {
            site.webcoMediaUrl && (
              <a class="card-action" href={site.webcoMediaUrl}>
                Visit Webco Media
              </a>
            )
          }
        </li>
        <li class="card">
          <h3>Webco Cloud</h3>
          <p>Runs hosting, domains, email, billing, renewals and support.</p>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand
    title="Already with Webco?"
    text="Open the client area for your website project. Use hosting login for an existing hosting account."
  >
    <a class="button" href={clientAreaHref()}>Client area</a>
    <a class="button button-quiet" href={hostingLoginHref()} rel="noopener noreferrer">Hosting login</a>
    <a class="button button-quiet" href="/support/">Get support</a>
  </CtaBand>
</BaseLayout>
