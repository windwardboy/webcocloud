---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { websiteOffers } from "../config/site";

const description =
  "Confirm your Webco website package and say whether you need a new domain or already have one.";

const packages = Object.fromEntries(
  websiteOffers.map((offer) => [
    offer.startPackage,
    { name: offer.startName, price: offer.price },
  ]),
);
---

<BaseLayout title="Start your website" description={description}>
  <PageHero eyebrow="Website setup" title="Your package, then your domain">
    <p>Choose a new domain or use one you already own. This step does not register a domain or take payment.</p>
  </PageHero>

  <section class="section" id="start-missing" hidden>
    <div class="wrap">
      <div class="section-head">
        <h2>Choose a website first</h2>
        <p class="section-intro">The package is selected on the website services page.</p>
      </div>
      <div class="actions">
        <a class="button" href="/websites/#essential">Essential Website</a>
        <a class="button button-quiet" href="/websites/#training">Training Provider Website</a>
      </div>
    </div>
  </section>

  <div id="start-flow" hidden>
    <section class="section" aria-labelledby="package-heading">
      <div class="wrap">
        <article class="card offer-card">
          <p class="eyebrow">Selected package</p>
          <h2 id="package-heading" data-package-name>Webco Essential</h2>
          <p class="price" data-package-price>£595</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="domain-choice-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="domain-choice-heading">What would you like to do with your domain?</h2>
        </div>
        <div class="cards cards-2" role="group" aria-label="Domain choice">
          <button class="card choice-card" type="button" data-path="new" aria-pressed="false">
            <span class="choice-title">I need a new domain</span>
            <p>Search for a name and see if it can be registered.</p>
          </button>
          <button class="card choice-card" type="button" data-path="existing" aria-pressed="false">
            <span class="choice-title">I already have a domain</span>
            <p>Tell us the domain you want this website to use.</p>
          </button>
        </div>

        <div id="new-domain" class="card domain-search" hidden>
          <h3 id="domain-search-heading">Check a domain</h3>
          <p>See whether a name such as example.co.uk can be registered. This does not register it.</p>
          <form id="domain-search" class="domain-form">
            <div class="domain-field">
              <label for="domain">Domain name</label>
              <input
                id="domain"
                name="domain"
                type="text"
                inputmode="url"
                autocomplete="off"
                spellcheck="false"
                maxlength="253"
                placeholder="example.co.uk"
                required
              />
            </div>
            <button class="button" type="submit">Check availability</button>
          </form>
          <p id="domain-search-result" class="domain-result" role="status"></p>
        </div>

        <div id="existing-domain" class="card domain-search" hidden>
          <h3>Your domain</h3>
          <form id="existing-domain-form" class="domain-form">
            <div class="domain-field">
              <label for="existing-domain-name">Domain name</label>
              <input
                id="existing-domain-name"
                name="domain"
                type="text"
                inputmode="url"
                autocomplete="off"
                spellcheck="false"
                maxlength="253"
                placeholder="example.co.uk"
                required
              />
            </div>
          </form>
          <p id="existing-domain-result" class="domain-result" role="status"></p>
        </div>

        <p id="start-saved" class="start-note" role="status"></p>
      </div>
    </section>
  </div>

  <script id="start-packages" type="application/json" set:html={JSON.stringify(packages)}></script>
</BaseLayout>

<script is:inline>
  const storageKey = "webco-cloud-onboarding";
  const packageData = JSON.parse(document.getElementById("start-packages").textContent || "{}");
  const selected = new URLSearchParams(window.location.search).get("package");
  const chosen = packageData[selected] ? selected : "";
  const missing = document.getElementById("start-missing");
  const flow = document.getElementById("start-flow");

  function readState() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function writeState(patch) {
    const next = { ...readState(), ...patch, package: chosen };
    if (!next.domain) delete next.domain;
    localStorage.setItem(storageKey, JSON.stringify(next));
    return next;
  }

  function normaliseDomain(value) {
    const domain = String(value || "")
      .trim()
      .toLowerCase()
      .replace(/^https?:\/\//, "")
      .replace(/\/.*$/, "")
      .replace(/\.$/, "");
    if (!/^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/.test(domain)) {
      return "";
    }
    return domain;
  }

  function showSaved(state) {
    const note = document.getElementById("start-saved");
    if (!note || !chosen) return;
    if (state.domain && state.domainPath) {
      note.textContent = packageData[chosen].name + " will use " + state.domain + ".";
      return;
    }
    note.textContent = "";
  }

  if (!chosen) {
    missing.hidden = false;
  } else {
    flow.hidden = false;
    document.querySelector("[data-package-name]").textContent = packageData[chosen].name;
    document.querySelector("[data-package-price]").textContent = packageData[chosen].price;
    const stored = readState();
    const samePackage = stored.package === chosen;
    const state = writeState({
      packageName: packageData[chosen].name,
      price: packageData[chosen].price,
      domainPath: samePackage ? stored.domainPath || "" : "",
      domain: samePackage ? stored.domain || "" : "",
    });

    const newPanel = document.getElementById("new-domain");
    const existingPanel = document.getElementById("existing-domain");
    const choiceButtons = document.querySelectorAll("[data-path]");

    function selectPath(path) {
      choiceButtons.forEach((button) => {
        button.setAttribute("aria-pressed", button.getAttribute("data-path") === path ? "true" : "false");
      });
      newPanel.hidden = path !== "new";
      existingPanel.hidden = path !== "existing";
      const current = writeState({ domainPath: path, domain: readState().domainPath === path ? readState().domain : "" });
      showSaved(current);
    }

    choiceButtons.forEach((button) => {
      button.addEventListener("click", () => selectPath(button.getAttribute("data-path")));
    });

    const existingInput = document.getElementById("existing-domain-name");
    const existingResult = document.getElementById("existing-domain-result");
    existingInput.addEventListener("input", () => {
      const domain = normaliseDomain(existingInput.value);
      const next = writeState({ domainPath: "existing", domain });
      if (!existingInput.value.trim()) {
        existingResult.textContent = "";
        existingResult.dataset.state = "";
      } else if (domain) {
        existingResult.dataset.state = "available";
        existingResult.textContent = domain + " will be used with this website.";
      } else {
        existingResult.dataset.state = "error";
        existingResult.textContent = "Enter a domain such as example.co.uk.";
      }
      showSaved(next);
    });

    if (state.domainPath === "new" || state.domainPath === "existing") {
      selectPath(state.domainPath);
      if (state.domain) {
        const field = state.domainPath === "existing" ? existingInput : document.getElementById("domain");
        field.value = state.domain;
        if (state.domainPath === "existing") existingInput.dispatchEvent(new Event("input"));
      }
    }

    const form = document.getElementById("domain-search");
    const result = document.getElementById("domain-search-result");
    const button = form.querySelector("button");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const domain = String(new FormData(form).get("domain") || "").trim();
      if (!domain) return;
      button.disabled = true;
      result.dataset.state = "";
      result.textContent = "Checking…";
      try {
        const response = await fetch("/domain-search.php", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new URLSearchParams({ domain }),
        });
        const data = await response.json();
        if (data.status === "available") {
          result.dataset.state = "available";
          result.textContent = data.domain + " is available.";
          showSaved(writeState({ domainPath: "new", domain: data.domain }));
        } else if (data.status === "unavailable") {
          result.dataset.state = "unavailable";
          result.textContent = data.domain + " is not available.";
          showSaved(writeState({ domainPath: "new", domain: "" }));
        } else if (response.status === 400) {
          result.dataset.state = "error";
          result.textContent = "Enter a domain such as example.co.uk.";
          showSaved(writeState({ domainPath: "new", domain: "" }));
        } else {
          result.dataset.state = "error";
          result.textContent = "We could not check that domain just now.";
        }
      } catch {
        result.dataset.state = "error";
        result.textContent = "We could not check that domain just now.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
