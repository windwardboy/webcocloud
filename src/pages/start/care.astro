---
import FunnelLayout from "../../layouts/FunnelLayout.astro";
import { commercial } from "../../config/site";

const description = "Choose Managed Care or standard hosting for your website.";
const standardHosting =
  "The website build is paid today. Standard hosting is £99 a year, with the first payment one year after checkout, then each year.";
---

<FunnelLayout title="Managed Care" description={description} step={4}>
  <section class="funnel-shell" id="care-missing" hidden>
    <h1>Review your details first</h1>
    <p class="funnel-lead">Managed Care is offered after the website package and business details are in place.</p>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/web-design/">Web design</a>
      <a class="button" href="/start/review/">Review</a>
    </div>
  </section>

  <div class="funnel-split" id="care-flow" hidden>
    <aside class="card funnel-summary">
      <p class="eyebrow" data-care-package></p>
      <h2 id="care-offer-heading">Managed Care</h2>
      <p class="price" id="care-price"></p>
      <p>Includes hosting. First payment 30 days after checkout, then monthly.</p>
    </aside>

    <div class="funnel-step">
      <h1>Managed Care</h1>
      <p class="funnel-lead">The website build is paid today. Managed Care includes hosting, maintenance and support.</p>
      <div class="cards cards-2" role="group" aria-label="Managed Care choice">
        <button class="card choice-card" type="button" data-care="managed" aria-pressed="false">
          <span class="choice-title">Add Managed Care</span>
          <p data-care-add></p>
        </button>
        <button class="card choice-card" type="button" data-care="standard" aria-pressed="false">
          <span class="choice-title">No thanks — use standard hosting</span>
          <p>The website build is paid today. Hosting is £99 a year, first charged one year after checkout.</p>
        </button>
      </div>
      <p id="care-standard" class="checkout-note" hidden>{standardHosting}</p>
    </div>

    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/start/review/">Back</a>
      <a class="button" id="care-continue" href="/start/checkout/" aria-disabled="true">Continue</a>
    </div>
  </div>
</FunnelLayout>

<script is:inline define:vars={{ carePrices: { essential: commercial.managedCare.essential, professional: commercial.managedCare.professional } }}>
  const storageKey = "webco-cloud-onboarding";

  function readState() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function writeCare(care) {
    const state = readState();
    state.care = care;
    localStorage.setItem(storageKey, JSON.stringify(state));
  }

  function updateContinue(ready) {
    const link = document.getElementById("care-continue");
    link.setAttribute("aria-disabled", ready ? "false" : "true");
    if (ready) link.removeAttribute("tabindex");
    else link.tabIndex = -1;
  }

  const state = readState();
  const details = state.details || {};
  const price = carePrices[state.package];
  const ready = Boolean(
    price &&
      state.packageName &&
      state.price &&
      state.domain &&
      details.businessName &&
      details.contactName &&
      details.email,
  );

  if (!ready) {
    document.getElementById("care-missing").hidden = false;
  } else {
    document.getElementById("care-flow").hidden = false;
    document.querySelector("[data-care-package]").textContent = state.packageName;
    document.getElementById("care-price").textContent = price;
    document.querySelector("[data-care-add]").textContent = "Add " + price + ". First payment 30 days after checkout, then monthly.";
    const standardNote = document.getElementById("care-standard");
    const buttons = document.querySelectorAll("[data-care]");

    function selectChoice(choice) {
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", button.getAttribute("data-care") === choice ? "true" : "false");
      });
      standardNote.hidden = choice !== "standard";
      writeCare(choice === "managed" ? { choice: "managed", price } : { choice: "standard" });
      updateContinue(true);
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => selectChoice(button.getAttribute("data-care")));
    });

    document.getElementById("care-continue").addEventListener("click", (event) => {
      if (event.currentTarget.getAttribute("aria-disabled") === "true") event.preventDefault();
    });

    if (state.care && (state.care.choice === "managed" || state.care.choice === "standard")) {
      selectChoice(state.care.choice);
    }
  }
</script>
