---
import FunnelLayout from "../../layouts/FunnelLayout.astro";
import { commercial, websitePackagePresentation } from "../../config/site";

const description = "Summary of the website order. Payment continues on Stripe Checkout.";
const standardHosting =
  "£99 a year. First payment one year after checkout, then each year. Not charged today.";
---

<FunnelLayout title="Checkout" description={description} step={5}>
  <section class="funnel-shell" id="checkout-missing" hidden>
    <h1>Choose hosting care first</h1>
    <p class="funnel-lead">The summary appears after the website, business details and Managed Care choice are saved in this browser.</p>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/web-design/">Web design</a>
      <a class="button" href="/start/care/">Managed Care</a>
    </div>
  </section>

  <section class="funnel-shell" id="checkout-flow" hidden>
    <h1>Payment</h1>
    <p class="funnel-lead">You pay the website build today. Managed Care or hosting is billed later. Coming back here does not mark the order paid.</p>
    <div class="funnel-pair">
    <article class="card purchase-preview" id="checkout-preview" hidden>
      <figure class="website-preview">
        <img data-checkout-preview alt="" width="1280" height="800" />
      </figure>
      <div class="purchase-preview-copy">
        <p class="eyebrow">Website you are purchasing</p>
        <h2 data-checkout-name></h2>
        <p class="price" data-checkout-price></p>
        <p>
          This is the website style you are purchasing. The finished website will be customised around your branding, content, services and business.
        </p>
        <a class="website-demo" data-checkout-demo target="_blank" rel="noopener noreferrer">View live demo</a>
      </div>
    </article>
    <article class="card">
      <h2>Order summary</h2>
      <dl class="summary" id="checkout-summary"></dl>
      <p class="checkout-note">Today's payment is the website build. The later care or hosting charge follows the schedule below.</p>
      <p class="checkout-note" id="domain-include-note" hidden>
        A new .uk or .co.uk domain is registered after payment as part of hosting or Managed Care. Existing domains are connected manually.
      </p>
      <p id="draft-result" class="start-note" role="status"></p>
    </article>
    </div>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/start/care/">Back</a>
      <button class="button" type="button" id="save-draft">Continue to payment</button>
    </div>
  </section>
  <script id="package-previews" type="application/json" set:html={JSON.stringify(websitePackagePresentation)}></script>
</FunnelLayout>

<script is:inline define:vars={{ standardHosting, carePrices: { essential: commercial.managedCare.essential, professional: commercial.managedCare.professional } }}>
  const storageKey = "webco-cloud-onboarding";
  const packageData = JSON.parse(document.getElementById("package-previews").textContent || "{}");

  function readState() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function presentationFor(state) {
    if (packageData[state.package]) return packageData[state.package];
    return Object.values(packageData).find((item) => item.name === state.packageName) || null;
  }

  function setPreview(img, path, alt) {
    const figure = img && img.closest("figure");
    if (!img || !figure || typeof path !== "string" || path.indexOf("/images/") !== 0) {
      if (figure) figure.hidden = true;
      return;
    }
    img.alt = alt;
    figure.hidden = true;
    img.addEventListener("load", () => {
      figure.hidden = false;
    }, { once: true });
    img.addEventListener("error", () => {
      figure.hidden = true;
    }, { once: true });
    img.src = path;
  }

  function setDemo(anchor, url) {
    if (!anchor) return;
    try {
      const parsed = new URL(url);
      if (parsed.protocol !== "https:") {
        anchor.hidden = true;
        return;
      }
      anchor.href = parsed.href;
    } catch {
      anchor.hidden = true;
    }
  }

  function row(label, value) {
    const item = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    term.textContent = label;
    detail.textContent = value;
    item.append(term, detail);
    return item;
  }

  const state = readState();
  const details = state.details || {};
  const care = state.care || {};
  const carePrice = carePrices[state.package];
  const complete = Boolean(
    state.packageName &&
      carePrice &&
      state.price &&
      state.domain &&
      details.businessName &&
      details.contactName &&
      (care.choice === "managed" || care.choice === "standard"),
  );

  if (!complete) {
    document.getElementById("checkout-missing").hidden = false;
  } else {
    document.getElementById("checkout-flow").hidden = false;
    const style = presentationFor(state);
    const preview = document.getElementById("checkout-preview");
    if (style && preview) {
      preview.hidden = false;
      setPreview(
        preview.querySelector("[data-checkout-preview]"),
        style.previewImage,
        "Preview of the " + (state.packageName || style.name) + " starting design",
      );
      preview.querySelector("[data-checkout-name]").textContent = state.packageName || style.name;
      preview.querySelector("[data-checkout-price]").textContent = state.price || style.price;
      setDemo(preview.querySelector("[data-checkout-demo]"), style.demoUrl);
    }
    const summary = document.getElementById("checkout-summary");
    const domain = (state.domainPath === "new" ? "New domain" : "Existing domain") + ", " + state.domain;
    const rows = [
      ["Website package", state.packageName],
      ["Website price", state.price],
      ["Domain", domain],
      ["Customer / business", details.businessName + ", " + details.contactName],
    ];
    if (care.choice === "managed") {
      rows.push(["Managed Care", carePrice + ". First payment 30 days after checkout, then monthly. Not charged today."]);
    } else {
      rows.push(["Hosting", standardHosting]);
    }
    rows.forEach(([label, value]) => summary.append(row(label, value)));

    const domainNote = document.getElementById("domain-include-note");
    if (domainNote) domainNote.hidden = state.domainPath !== "new";

    const result = document.getElementById("draft-result");
    const button = document.getElementById("save-draft");

    function rememberOrder(orderId) {
      if (typeof orderId !== "string" || !/^wc_[a-f0-9]{20}$/.test(orderId)) {
        return;
      }
      const next = readState();
      next.draftOrderId = orderId;
      localStorage.setItem(storageKey, JSON.stringify(next));
    }

    function isStripeCheckoutUrl(value) {
      if (typeof value !== "string" || value.length > 2048) {
        return false;
      }
      try {
        const url = new URL(value);
        return (
          url.protocol === "https:" &&
          url.hostname === "checkout.stripe.com" &&
          url.pathname.includes("/cs_test_")
        );
      } catch {
        return false;
      }
    }

    button.addEventListener("click", async () => {
      button.disabled = true;
      result.textContent = "Saving the order…";
      try {
        const response = await fetch("/draft-order.php", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(readState()),
        });
        const data = await response.json();
        rememberOrder(data.orderId);
        if (response.ok && data.pending === true && data.orderId) {
          window.location.assign("/start/checkout/success/?order=" + encodeURIComponent(data.orderId));
          return;
        }
        if (!response.ok || !isStripeCheckoutUrl(data.checkoutUrl)) {
          result.textContent = "The order could not be sent to payment.";
          button.disabled = false;
          return;
        }
        result.textContent = "Opening Stripe Checkout…";
        window.location.assign(data.checkoutUrl);
      } catch {
        result.textContent = "The order could not be sent to payment.";
        button.disabled = false;
      }
    });
  }
</script>
