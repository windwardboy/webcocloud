---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { commercial } from "../../config/site";

const description = "Summary of the website order. Payment continues on Stripe Checkout.";
const standardHosting =
  "Your first 12 months of hosting are included. After that, standard hosting is £99/year.";
---

<BaseLayout title="Checkout" description={description}>
  <PageHero eyebrow="Website setup" title="Checkout">
    <p>
      The order is saved first, then you continue to Stripe to pay. Returning from Stripe does not mark the order as paid.
    </p>
  </PageHero>

  <section class="section" id="checkout-missing" hidden>
    <div class="wrap">
      <div class="section-head">
        <h2>Choose hosting care first</h2>
        <p class="section-intro">The summary appears after the website, business details and Managed Care choice are saved in this browser.</p>
      </div>
      <div class="actions">
        <a class="button" href="/start/care/">Managed Care</a>
        <a class="button button-quiet" href="/websites/">Choose a website</a>
      </div>
    </div>
  </section>

  <section class="section" id="checkout-flow" hidden>
    <div class="wrap">
      <article class="card">
        <h2>Order summary</h2>
        <dl class="summary" id="checkout-summary"></dl>
        <p class="checkout-note">
          Continue to Stripe Checkout to pay. The website and care choices on this page are not used as the price.
        </p>
        <div class="actions">
          <button class="button" type="button" id="save-draft">Continue to payment</button>
          <a class="button button-quiet" href="/start/care/">Back</a>
        </div>
        <p id="draft-result" class="start-note" role="status"></p>
      </article>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ standardHosting, carePrices: { essential: commercial.managedCare.essential, professional: commercial.managedCare.professional } }}>
  const storageKey = "webco-cloud-onboarding";

  function readState() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function row(label, value) {
    const item = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    term.textContent = label;
    detail.textContent = value;
    item.append(term, detail);
    return item;
  }

  const state = readState();
  const details = state.details || {};
  const care = state.care || {};
  const carePrice = carePrices[state.package];
  const complete = Boolean(
    state.packageName &&
      carePrice &&
      state.price &&
      state.domain &&
      details.businessName &&
      details.contactName &&
      (care.choice === "managed" || care.choice === "standard"),
  );

  if (!complete) {
    document.getElementById("checkout-missing").hidden = false;
  } else {
    document.getElementById("checkout-flow").hidden = false;
    const summary = document.getElementById("checkout-summary");
    const domain = (state.domainPath === "new" ? "New domain" : "Existing domain") + ", " + state.domain;
    const rows = [
      ["Website package", state.packageName],
      ["Website price", state.price],
      ["Domain", domain],
      ["Customer / business", details.businessName + ", " + details.contactName],
    ];
    if (care.choice === "managed") {
      rows.push(["Managed Care", "Added, " + carePrice]);
    } else {
      rows.push(["Hosting", "Standard hosting. " + standardHosting]);
    }
    rows.forEach(([label, value]) => summary.append(row(label, value)));

    const result = document.getElementById("draft-result");
    const button = document.getElementById("save-draft");

    function rememberOrder(orderId) {
      if (typeof orderId !== "string" || !/^wc_[a-f0-9]{20}$/.test(orderId)) {
        return;
      }
      const next = readState();
      next.draftOrderId = orderId;
      localStorage.setItem(storageKey, JSON.stringify(next));
    }

    function isStripeCheckoutUrl(value) {
      if (typeof value !== "string" || value.length > 2048) {
        return false;
      }
      try {
        const url = new URL(value);
        return (
          url.protocol === "https:" &&
          url.hostname === "checkout.stripe.com" &&
          url.pathname.includes("/cs_test_")
        );
      } catch {
        return false;
      }
    }

    button.addEventListener("click", async () => {
      button.disabled = true;
      result.textContent = "Saving the order…";
      try {
        const response = await fetch("/draft-order.php", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(readState()),
        });
        const data = await response.json();
        rememberOrder(data.orderId);
        if (!response.ok || !isStripeCheckoutUrl(data.checkoutUrl)) {
          result.textContent = "The order could not be sent to payment.";
          button.disabled = false;
          return;
        }
        result.textContent = "Opening Stripe Checkout…";
        window.location.assign(data.checkoutUrl);
      } catch {
        result.textContent = "The order could not be sent to payment.";
        button.disabled = false;
      }
    });
  }
</script>
