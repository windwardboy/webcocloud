---
import FunnelLayout from "../../../layouts/FunnelLayout.astro";

const description = "Stripe Checkout was cancelled. The Webco order is not marked paid.";
---

<FunnelLayout title="Payment cancelled" description={description} noindex phase="payment">
  <section class="funnel-shell">
    <h1>Payment was not completed</h1>
    <p class="funnel-lead">Stripe returned you here before the payment was finished. This order is not marked paid.</p>
    <article class="card">
      <h2>Order reference</h2>
      <p id="order-reference" class="checkout-note">No order reference was included on this return.</p>
    </article>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/support/">Support</a>
      <a class="button" href="/start/checkout/">Return to checkout</a>
    </div>
  </section>
</FunnelLayout>

<script is:inline>
  const result = document.getElementById("order-reference");
  const orderId = new URLSearchParams(window.location.search).get("order") || "";
  if (/^wc_[a-f0-9]{20}$/.test(orderId)) {
    result.textContent = "Order reference " + orderId + ".";
  }
</script>
