---
import FunnelLayout from "../../../layouts/FunnelLayout.astro";

const description = "Payment status for a Webco Cloud website order.";
---

<FunnelLayout title="Your order" description={description} noindex phase="payment">
  <section class="funnel-shell">
    <h1 id="payment-heading">Checking your payment</h1>
    <p id="payment-lead" class="funnel-lead">Checking this order.</p>
    <article class="card">
      <p id="payment-message" class="checkout-note" role="status">Checking this order.</p>
      <dl class="summary" id="payment-summary" hidden></dl>
      <p id="payment-next" class="start-note" hidden></p>
    </article>
    <div class="funnel-dock actions">
      <button class="button" type="button" id="payment-refresh" hidden>Check again</button>
      <a class="button button-quiet" href="/support/">Support</a>
    </div>
  </section>
</FunnelLayout>

<script is:inline>
  const lead = document.getElementById("payment-lead");
  const heading = document.getElementById("payment-heading");
  const message = document.getElementById("payment-message");
  const summary = document.getElementById("payment-summary");
  const next = document.getElementById("payment-next");
  const refresh = document.getElementById("payment-refresh");
  const requestedId = new URLSearchParams(window.location.search).get("order") || "";

  function row(label, value) {
    const item = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    term.textContent = label;
    detail.textContent = value;
    item.append(term, detail);
    return item;
  }

  function showUnknown() {
    lead.textContent = "Contact support if you need help with this return.";
    heading.textContent = "We could not confirm this order";
    message.textContent = "We could not find an order for this return. If you have just paid, contact support and keep any receipt from Stripe.";
    summary.hidden = true;
    summary.replaceChildren();
    next.hidden = true;
    next.textContent = "";
    refresh.hidden = true;
  }

  function showDraft(orderId) {
    lead.textContent = "Payment is being confirmed.";
    heading.textContent = "Payment is being confirmed";
    message.textContent = "Payment is being confirmed. Check again in a moment. You do not need to pay again while this is in progress.";
    summary.hidden = false;
    summary.replaceChildren(row("Order reference", orderId));
    next.hidden = true;
    next.textContent = "";
    refresh.hidden = false;
  }

  function showPaid(data) {
    const rows = [row("Order reference", data.orderId)];
    if (data.packageName === "Webco Essential" || data.packageName === "Webco Professional") {
      rows.push(row("Website package", data.packageName));
    }
    if (/^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/.test(data.domain || "")) {
      rows.push(row("Domain", data.domain));
    }
    if (data.care === "managed") {
      rows.push(row("Hosting", "Managed Care"));
    } else if (data.care === "standard") {
      rows.push(row("Hosting", "Annual hosting"));
    }
    lead.textContent = "Payment received.";
    heading.textContent = "Payment received";
    message.textContent = "Payment has been received for this order.";
    summary.hidden = false;
    summary.replaceChildren(...rows);
    next.hidden = false;
    next.textContent = "Webco will use these details to start the website. You do not need to pay again.";
    refresh.hidden = true;
  }

  function applyStatus(data) {
    if (!data || typeof data !== "object") {
      showUnknown();
      return;
    }
    if (data.status === "draft" && data.orderId === requestedId) {
      showDraft(data.orderId);
      return;
    }
    if (data.status === "paid" && data.orderId === requestedId) {
      showPaid(data);
      return;
    }
    showUnknown();
  }

  async function checkOrder() {
    lead.textContent = "Checking this order.";
    heading.textContent = "Checking your payment";
    message.textContent = "Checking this order.";
    summary.hidden = true;
    summary.replaceChildren();
    next.hidden = true;
    next.textContent = "";
    refresh.disabled = true;
    if (!/^wc_[a-f0-9]{20}$/.test(requestedId)) {
      showUnknown();
      refresh.disabled = false;
      return;
    }
    try {
      const response = await fetch("/order-status.php?order=" + encodeURIComponent(requestedId), {
        headers: { Accept: "application/json" },
      });
      const data = await response.json();
      if (!response.ok) {
        showUnknown();
        return;
      }
      applyStatus(data);
    } catch {
      showUnknown();
    } finally {
      refresh.disabled = false;
    }
  }

  refresh.addEventListener("click", () => {
    checkOrder();
  });
  checkOrder();
</script>
