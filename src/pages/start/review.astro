---
import FunnelLayout from "../../layouts/FunnelLayout.astro";
import { websitePackagePresentation } from "../../config/site";

const description = "Review the website package, domain and business details before checkout.";
---

<FunnelLayout title="Review" description={description} step={3}>
  <section class="funnel-shell" id="review-missing" hidden>
    <h1>Nothing to review yet</h1>
    <p class="funnel-lead">Choose a website and add the business details first.</p>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/start/details/">Business details</a>
      <a class="button" href="/web-design/">Web design</a>
    </div>
  </section>

  <section class="funnel-shell" id="review-flow" hidden>
    <h1>Review</h1>
    <p class="funnel-lead">Check the package, domain and business details.</p>
    <div class="funnel-pair">
    <article class="card your-website" id="review-website" hidden>
      <p class="eyebrow">Your website</p>
      <figure class="website-preview">
        <img data-review-preview alt="" width="1280" height="800" />
      </figure>
      <h2 data-review-name></h2>
      <p class="price" data-review-price></p>
      <p data-review-domain></p>
      <a class="website-demo" data-review-demo target="_blank" rel="noopener noreferrer">View live demo</a>
    </article>
    <article class="card">
      <h2>Order summary</h2>
      <dl class="summary" id="review-summary"></dl>
      <p class="checkout-note">Nothing is paid on this page.</p>
      <p class="checkout-note">
        A new .uk or .co.uk domain is registered after payment with hosting or Managed Care. Existing domains stay under your current registrar until connected.
      </p>
    </article>
    </div>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/start/details/">Back</a>
      <a class="button" href="/start/care/">Continue</a>
    </div>
  </section>
  <script id="package-previews" type="application/json" set:html={JSON.stringify(websitePackagePresentation)}></script>
</FunnelLayout>

<script is:inline>
  const storageKey = "webco-cloud-onboarding";
  const packageData = JSON.parse(document.getElementById("package-previews").textContent || "{}");

  function readState() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function presentationFor(state) {
    if (packageData[state.package]) return packageData[state.package];
    return Object.values(packageData).find((item) => item.name === state.packageName) || null;
  }

  function setPreview(img, path, alt) {
    const figure = img && img.closest("figure");
    if (!img || !figure || typeof path !== "string" || path.indexOf("/images/") !== 0) {
      if (figure) figure.hidden = true;
      return;
    }
    img.alt = alt;
    figure.hidden = true;
    img.addEventListener("load", () => {
      figure.hidden = false;
    }, { once: true });
    img.addEventListener("error", () => {
      figure.hidden = true;
    }, { once: true });
    img.src = path;
  }

  function setDemo(anchor, url) {
    if (!anchor) return;
    try {
      const parsed = new URL(url);
      if (parsed.protocol !== "https:") {
        anchor.hidden = true;
        return;
      }
      anchor.href = parsed.href;
    } catch {
      anchor.hidden = true;
    }
  }

  function row(label, value) {
    const item = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    term.textContent = label;
    detail.textContent = value;
    item.append(term, detail);
    return item;
  }

  const state = readState();
  const details = state.details || {};
  const complete = Boolean(
    state.package &&
      state.packageName &&
      state.price &&
      state.domainPath &&
      state.domain &&
      details.businessName &&
      details.contactName &&
      details.email &&
      details.phone &&
      details.address1 &&
      details.town &&
      details.postcode &&
      details.contactMethod,
  );

  if (!complete) {
    document.getElementById("review-missing").hidden = false;
  } else {
    document.getElementById("review-flow").hidden = false;
    const style = presentationFor(state);
    const website = document.getElementById("review-website");
    if (style && website) {
      website.hidden = false;
      setPreview(
        website.querySelector("[data-review-preview]"),
        style.previewImage,
        "Preview of the " + style.name + " starting design",
      );
      website.querySelector("[data-review-name]").textContent = state.packageName || style.name;
      website.querySelector("[data-review-price]").textContent = state.price || style.price;
      const domain = website.querySelector("[data-review-domain]");
      const domainName = document.createElement("strong");
      domainName.className = "domain-value";
      domainName.textContent = state.domain;
      domain.replaceChildren(
        document.createTextNode((state.domainPath === "new" ? "New domain, " : "Existing domain, ")),
        domainName,
      );
      setDemo(website.querySelector("[data-review-demo]"), style.demoUrl);
    }
    const summary = document.getElementById("review-summary");
    const method = { email: "Email", phone: "Phone", whatsapp: "WhatsApp" }[details.contactMethod] || details.contactMethod;
    const address = [details.address1, details.address2, details.town, details.county, details.postcode]
      .filter(Boolean)
      .join(", ");
    function addRows(target, pairs) {
      pairs.forEach(([label, value]) => target.append(row(label, value)));
    }
    addRows(summary, [
      ["Package", state.packageName],
      ["Price", state.price],
      ["Business / trading name", details.businessName],
    ]);
    const domainItem = row("Domain", "");
    const domainValue = domainItem.querySelector("dd");
    const domainName = document.createElement("strong");
    domainName.className = "domain-value";
    domainName.textContent = state.domain;
    domainValue.append(document.createTextNode((state.domainPath === "new" ? "New domain, " : "Existing domain, ")), domainName);
    summary.insertBefore(domainItem, summary.children[2] || null);
    const contact = document.createElement("div");
    contact.className = "review-group";
    addRows(contact, [
      ["Contact name", details.contactName],
      ["Email address", details.email],
      ["Phone number", details.phone],
      ["Preferred contact method", method],
    ]);
    summary.append(contact);
    const place = document.createElement("div");
    place.className = "review-group";
    const placeRows = [["Address", address]];
    if (details.companyNumber) placeRows.push(["Company number", details.companyNumber]);
    addRows(place, placeRows);
    summary.append(place);
  }
</script>
