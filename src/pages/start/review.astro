---
import FunnelLayout from "../../layouts/FunnelLayout.astro";

const description = "Review the website package, domain and business details before checkout.";
---

<FunnelLayout title="Review" description={description} step={3} track="narrow">
  <section class="funnel-shell" id="review-missing" hidden>
    <h1>Nothing to review yet</h1>
    <p class="funnel-lead">Choose a website and add the business details first.</p>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/start/details/">Business details</a>
      <a class="button" href="/websites/">Choose a website</a>
    </div>
  </section>

  <section class="funnel-shell" id="review-flow" hidden>
    <h1>Review</h1>
    <p class="funnel-lead">Check the package, domain and business details.</p>
    <article class="card">
      <h2>Order summary</h2>
      <dl class="summary" id="review-summary"></dl>
      <p class="checkout-note">Nothing is paid on this page.</p>
    </article>
    <div class="funnel-dock actions">
      <a class="button button-quiet" href="/start/details/">Back</a>
      <a class="button" href="/start/care/">Continue</a>
    </div>
  </section>
</FunnelLayout>

<script is:inline>
  const storageKey = "webco-cloud-onboarding";

  function readState() {
    try {
      return JSON.parse(localStorage.getItem(storageKey) || "{}");
    } catch {
      return {};
    }
  }

  function row(label, value) {
    const item = document.createElement("div");
    const term = document.createElement("dt");
    const detail = document.createElement("dd");
    term.textContent = label;
    detail.textContent = value;
    item.append(term, detail);
    return item;
  }

  const state = readState();
  const details = state.details || {};
  const complete = Boolean(
    state.package &&
      state.packageName &&
      state.price &&
      state.domainPath &&
      state.domain &&
      details.businessName &&
      details.contactName &&
      details.email &&
      details.phone &&
      details.address1 &&
      details.town &&
      details.postcode &&
      details.contactMethod,
  );

  if (!complete) {
    document.getElementById("review-missing").hidden = false;
  } else {
    document.getElementById("review-flow").hidden = false;
    const summary = document.getElementById("review-summary");
    const method = { email: "Email", phone: "Phone", whatsapp: "WhatsApp" }[details.contactMethod] || details.contactMethod;
    const address = [details.address1, details.address2, details.town, details.county, details.postcode]
      .filter(Boolean)
      .join(", ");
    function addRows(target, pairs) {
      pairs.forEach(([label, value]) => target.append(row(label, value)));
    }
    addRows(summary, [
      ["Package", state.packageName],
      ["Price", state.price],
      ["Business / trading name", details.businessName],
    ]);
    const domainItem = row("Domain", "");
    const domainValue = domainItem.querySelector("dd");
    const domainName = document.createElement("strong");
    domainName.className = "domain-value";
    domainName.textContent = state.domain;
    domainValue.append(document.createTextNode((state.domainPath === "new" ? "New domain, " : "Existing domain, ")), domainName);
    summary.insertBefore(domainItem, summary.children[2] || null);
    const contact = document.createElement("div");
    contact.className = "review-group";
    addRows(contact, [
      ["Contact name", details.contactName],
      ["Email address", details.email],
      ["Phone number", details.phone],
      ["Preferred contact method", method],
    ]);
    summary.append(contact);
    const place = document.createElement("div");
    place.className = "review-group";
    const placeRows = [["Address", address]];
    if (details.companyNumber) placeRows.push(["Company number", details.companyNumber]);
    addRows(place, placeRows);
    summary.append(place);
  }
</script>
