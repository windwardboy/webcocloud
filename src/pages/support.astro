---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../config/site";
import { clientLoginHref, clientLoginIsExternal } from "../lib/links";

const description =
  "Support for Webco Cloud hosting, domains, email and websites, plus the customer login.";
const hasContact = site.supportEmail.length > 0 || site.supportPhone.length > 0;
const loginExternal = clientLoginIsExternal();
---

<BaseLayout title="Support" description={description}>
  <PageHero eyebrow="Support" title="Help with the website, domain and email">
    <p>
      The customer area is where you manage services, invoices, renewals and support for your website.
    </p>
    <div class="actions">
      <a class="button" href={clientLoginHref()} rel={loginExternal ? "noopener noreferrer" : undefined}>
        Client login
      </a>
    </div>
  </PageHero>

  <section class="section" id="client-login" aria-labelledby="login-heading">
    <div class="wrap">
      <div class="panel">
        <div>
          <p class="eyebrow">Customers</p>
          <h2 id="login-heading">Client login</h2>
        </div>
        <div>
          <p>Sign in to manage your website, domain, email, invoices and renewals.</p>
          {
            loginExternal && (
              <div class="actions">
                <a class="button" href={site.clientLoginUrl} rel="noopener noreferrer">
                  Open customer area
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ask-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ask-heading">How we can help</h2>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>The website</h3>
          <p>Availability, and routine content changes on Managed Care.</p>
        </li>
        <li class="card">
          <h3>Domain and hosting</h3>
          <p>Renewals, the site staying online, and SSL.</p>
        </li>
        <li class="card">
          <h3>Email setup</h3>
          <p>The mailboxes we created and the settings we provided.</p>
        </li>
      </ul>
      <p class="follow-on">
        Routine website changes are part of Managed Care.
        <a href="/hosting/#managed-care">See hosting options</a>.
      </p>
    </div>
  </section>

  {
    hasContact && (
      <section class="section" id="contact" aria-labelledby="contact-heading">
        <div class="wrap">
          <div class="section-head">
            <h2 id="contact-heading">Contact</h2>
          </div>
          <ul class="cards cards-2">
            {site.supportEmail && (
              <li class="card">
                <h3>Email</h3>
                <p>
                  <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
                </p>
              </li>
            )}
            {site.supportPhone && (
              <li class="card">
                <h3>Phone</h3>
                <p>
                  <a href={`tel:${site.supportPhone.replace(/\s+/g, "")}`}>{site.supportPhone}</a>
                </p>
              </li>
            )}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Need something changed on the website?"
    text="Routine updates are included with Managed Care. Larger changes are quoted separately."
  >
    <a class="button" href="/hosting/#managed-care">View Managed Care</a>
    <a class="button button-quiet" href={clientLoginHref()}>Client login</a>
  </CtaBand>
</BaseLayout>
