---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../config/site";
import { clientAreaHref, hostingLoginHref } from "../lib/links";

const description =
  "Support for websites, hosting, domains and email on Webco Cloud, including the client area and hosting login.";
const hasContact = site.supportEmail.length > 0 || site.supportPhone.length > 0;
const areaHref = clientAreaHref();
const hostingHref = hostingLoginHref();
---

<BaseLayout title="Support" description={description}>
  <PageHero eyebrow="Support" title="Help with the website, domain and email">
    <p>
      The client area is for your website project. Hosting login is the existing hosting account, and it is separate.
    </p>
    <div class="actions">
      <a class="button" href={areaHref}>Client area</a>
      {
        hostingHref && (
          <a class="button button-quiet" href={hostingHref} rel="noopener noreferrer">
            Hosting login
          </a>
        )
      }
    </div>
  </PageHero>

  <section class="section" id="client-area" aria-labelledby="client-area-heading">
    <div class="wrap">
      <div class="panel">
        <div>
          <p class="eyebrow">Website customers</p>
          <h2 id="client-area-heading">Client area</h2>
        </div>
        <div>
          <p>
            Your website project, brief and requests. If you are not already in, open the secure link from your Webco email.
          </p>
          <div class="actions">
            <a class="button" href={areaHref}>Open client area</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    hostingHref && (
      <section class="section" id="client-login" aria-labelledby="hosting-login-heading">
        <div class="wrap">
          <div class="panel">
            <div>
              <p class="eyebrow">Existing hosting</p>
              <h2 id="hosting-login-heading">Hosting login</h2>
            </div>
            <div>
              <p>
                Opens the existing hosting account for domains, email and renewals. This is separate from the Webco client area.
              </p>
              <div class="actions">
                <a class="button button-quiet" href={hostingHref} rel="noopener noreferrer">
                  Hosting login
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="ask-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ask-heading">How we can help</h2>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>The website</h3>
          <p>Availability, and routine content changes on Managed Care.</p>
        </li>
        <li class="card">
          <h3>Domain and hosting</h3>
          <p>Renewals, the site staying online, and SSL.</p>
        </li>
        <li class="card">
          <h3>Email setup</h3>
          <p>The mailboxes we created and the settings we provided.</p>
        </li>
      </ul>
      <p class="follow-on">
        Routine website changes are part of Managed Care.
        <a href="/hosting/#managed-care">See hosting options</a>.
      </p>
    </div>
  </section>

  {
    hasContact && (
      <section class="section" id="contact" aria-labelledby="contact-heading">
        <div class="wrap">
          <div class="section-head">
            <h2 id="contact-heading">Contact</h2>
          </div>
          <ul class="cards cards-2">
            {site.supportEmail && (
              <li class="card">
                <h3>Email</h3>
                <p>
                  <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
                </p>
              </li>
            )}
            {site.supportPhone && (
              <li class="card">
                <h3>Phone</h3>
                <p>
                  <a href={`tel:${site.supportPhone.replace(/\s+/g, "")}`}>{site.supportPhone}</a>
                </p>
              </li>
            )}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Need something changed on the website?"
    text="Routine updates are included with Managed Care. Larger changes are quoted separately."
  >
    <a class="button" href="/hosting/#managed-care">View Managed Care</a>
    <a class="button button-quiet" href={areaHref}>Client area</a>
  </CtaBand>
</BaseLayout>
