---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { site, websiteCategories } from "../../config/site";

const description =
  "Web design by Webco Media — clear, professional websites for UK businesses, looked after on Webco Cloud.";

const questions = [
  {
    question: "Who designs and builds the website?",
    answer:
      "Webco Media designs and builds the site. Webco Cloud is where you purchase, manage billing, hosting, domain, email and support once the project is under way.",
  },
  {
    question: "What kind of websites do you create?",
    answer:
      "Professional enquiry websites that present your business clearly, work well on mobile, and make it easy for people to get in touch. Larger systems such as booking or ecommerce are quoted separately.",
  },
  {
    question: "Can I see examples?",
    answer:
      "Yes. Live demos are grouped by industry on dedicated landing pages. More categories will be added as new demos go live.",
  },
  {
    question: "What happens after the website is built?",
    answer:
      "Hosting, domain, business email, renewals and support sit in Webco Cloud, so there is one place to go for the live website.",
  },
];
---

<BaseLayout title="Web design" description={description}>
  <PageHero eyebrow="Webco Media" title="Web design for UK businesses">
    <p>
      Clear, professional websites designed and built by Webco Media — then hosted and supported on Webco Cloud.
    </p>
    <div class="actions">
      {
        site.webcoMediaUrl && (
          <a class="button" href={site.webcoMediaUrl} rel="noopener noreferrer">
            Visit Webco Media
          </a>
        )
      }
      <a class="button button-quiet" href="#examples">See examples</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="approach-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="approach-heading">A straightforward approach</h2>
        <p class="section-intro">
          Good web design should make your business easy to understand and easy to contact — not bury it under noise.
        </p>
      </div>
      <ul class="cards cards-3">
        <li class="card">
          <h3>Clear structure</h3>
          <p>Pages are organised around what visitors need: what you offer, where you are, and how to enquire.</p>
        </li>
        <li class="card">
          <h3>Built for your business</h3>
          <p>Each site is customised with your branding, services, locations and contact details — not left as a stock template.</p>
        </li>
        <li class="card">
          <h3>Ready for everyday use</h3>
          <p>Mobile-friendly layouts, sensible SEO foundations, and a path from first visit through to an enquiry.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-heading">How a project usually runs</h2>
      </div>
      <ul class="cards cards-4">
        <li class="card">
          <h3>1. Brief</h3>
          <p>You tell us about the business, services, locations and the look you want.</p>
        </li>
        <li class="card">
          <h3>2. Design and build</h3>
          <p>Webco Media designs the site and builds it around your content and branding.</p>
        </li>
        <li class="card">
          <h3>3. Go live</h3>
          <p>Domain, hosting, SSL and business email are set up so the site can launch properly.</p>
        </li>
        <li class="card">
          <h3>4. Ongoing care</h3>
          <p>Webco Cloud looks after hosting, renewals and support, with optional Managed Care for routine updates.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="examples" aria-labelledby="examples-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Examples</p>
        <h2 id="examples-heading">Industry demos</h2>
        <p class="section-intro">
          Each industry page shows live demos for that type of business. More categories will appear here as they go live.
        </p>
      </div>
      <ul class="cards cards-2">
        {
          websiteCategories.map((category) => (
            <li class="card">
              <p class="eyebrow">Available now</p>
              <h3>{category.name}</h3>
              <p>{category.summary}</p>
              <a class="card-action" href={category.href}>
                View {category.name} demos
              </a>
            </li>
          ))
        }
        <li class="card card-muted">
          <p class="eyebrow">Coming next</p>
          <h3>More industries</h3>
          <p>
            Further demo sets will be published here for other types of UK business.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="roles-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="roles-heading">Who does what</h2>
      </div>
      <ul class="cards cards-2">
        <li class="card">
          <h3>Webco Media</h3>
          <p>Designs and builds the website.</p>
          {
            site.webcoMediaUrl && (
              <a class="card-action" href={site.webcoMediaUrl} rel="noopener noreferrer">
                Visit Webco Media
              </a>
            )
          }
        </li>
        <li class="card">
          <h3>Webco Cloud</h3>
          <p>Purchase, accounts, billing, hosting, domains, email and support after the site is under way.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-heading">Common questions</h2>
      </div>
      <ul class="qa">
        {
          questions.map((item) => (
            <li>
              <details name="web-design-faq">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Want to see a live example?"
    text="Open an industry demo page, or visit Webco Media to learn more about the design and build work."
  >
    <a class="button" href={websiteCategories[0].href}>
      {websiteCategories[0].name} demos
    </a>
    {
      site.webcoMediaUrl && (
        <a class="button button-quiet" href={site.webcoMediaUrl} rel="noopener noreferrer">
          Visit Webco Media
        </a>
      )
    }
  </CtaBand>
</BaseLayout>
