---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { websiteOffers } from "../config/site";

const description =
  "Essential and Professional websites built by Webco Media — starting with HGV training demos, with more business categories to follow.";

const offers = {
  essential: websiteOffers[0],
  professional: websiteOffers[1],
};

const questions = [
  {
    question: "Is this only for HGV training providers?",
    answer:
      "No. HGV training is the first category with live demos today. The Essential and Professional packages are for UK businesses more widely. More industry examples will be added as we expand.",
  },
  {
    question: "What if I already have a website?",
    answer:
      "Either package can replace the site you have now. Webco Media builds the new one. Webco Cloud then looks after hosting, the domain and email.",
  },
  {
    question: "Can I upgrade later?",
    answer:
      "Yes. Start with Essential when you have one location and a straightforward offer. When you need separate service and location pages, we move you onto the Professional Website and quote that work.",
  },
  {
    question: "What if I already have a domain?",
    answer:
      "We connect the domain you already own to the website and to your business email. A new domain can be registered during setup when you need one.",
  },
  {
    question: "What if I add more services or locations?",
    answer:
      "Essential covers one main location and your core service information. Several services or locations, each with its own page, are what the Professional Website is for.",
  },
  {
    question: "Is booking, a shop, or custom software included?",
    answer:
      "Both packages are enquiry websites. Online booking, ecommerce and bespoke systems are quoted separately.",
  },
];
---

<BaseLayout title="Website services" description={description}>
  <PageHero eyebrow="Built by Webco Media" title="Two packages. Built for your business.">
    <p>
      Essential and Professional work across many types of UK business. The live demos below are from our first category — HGV training — with more industries coming soon.
    </p>
  </PageHero>

  <section class="section" aria-labelledby="offers-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="offers-heading">Choose a package</h2>
        <p class="section-intro">
          Same two website packages either way. The demos show how they look for HGV training providers first.
        </p>
      </div>
      <div class="cards cards-2">
        {
          websiteOffers.map((offer) => (
            <article class="card offer-card" id={offer.id}>
              <figure class="website-preview">
                <img
                  src={offer.previewImage}
                  alt={`Preview of the ${offer.name} starting design for ${offer.demoCategory}`}
                  width="1280"
                  height="800"
                  onerror="this.closest('figure').hidden = true"
                />
              </figure>
              <p class="eyebrow">{offer.audience}</p>
              <h3>{offer.name}</h3>
              <p class="price">{offer.price}</p>
              <p>{offer.summary}</p>
              <ul class="offer-points">
                {offer.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <p class="offer-note">
                Live demo: {offer.demoCategory}. Your finished website is customised for your business — not delivered as an unchanged template.
              </p>
              <div class="actions">
                <a class="button button-quiet" href={offer.demoUrl} target="_blank" rel="noopener noreferrer">
                  View live demo
                </a>
                <a class="button" href={`/start/?package=${offer.startPackage}`}>Choose this website</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="demos" aria-labelledby="demos-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Examples</p>
        <h2 id="demos-heading">First category: HGV training</h2>
        <p class="section-intro">
          These two live demos show Essential and Professional for HGV and transport training. They are examples of the packages — not the only businesses we build for. Further categories will appear here as they go live.
        </p>
      </div>
      <ul class="cards cards-2">
        <li class="card">
          <h3>{offers.essential.name}</h3>
          <p>
            A straightforward site for one main location: what you offer, where you are, and a clear way to enquire.
          </p>
          <a class="card-action" href={offers.essential.demoUrl} target="_blank" rel="noopener noreferrer">
            View Essential demo
          </a>
        </li>
        <li class="card">
          <h3>{offers.professional.name}</h3>
          <p>
            Separate pages for key services and locations, so local searches can land in the right place and continue to an enquiry.
          </p>
          <a class="card-action" href={offers.professional.demoUrl} target="_blank" rel="noopener noreferrer">
            View Professional demo
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-heading">Common questions</h2>
      </div>
      <ul class="qa">
        {
          questions.map((item) => (
            <li>
              <details name="websites-faq">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Ready to choose a package?"
    text="Pick Essential or Professional, then continue on Webco Cloud. More industry demos will follow the HGV training examples."
  >
    <a class="button" href="#essential">Essential Website</a>
    <a class="button button-quiet" href="#professional">Professional Website</a>
  </CtaBand>
</BaseLayout>
