---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { websiteOffers } from "../config/site";

const description =
  "Essential Website at £595, or the Professional Website at £995 — built by Webco Media, looked after on Webco Cloud.";

const offers = {
  essential: websiteOffers[0],
  training: websiteOffers[1],
};

const questions = [
  {
    question: "What if I already have a website?",
    answer:
      "Either package can replace the site you have now. Webco Media builds the new one. Webco Cloud then looks after hosting, the domain and email.",
  },
  {
    question: "Can I upgrade later?",
    answer:
      "Yes. Start with Essential when you have one location and a straightforward offer. When you need separate service and location pages, we move you onto the Professional Website and quote that work.",
  },
  {
    question: "What if I already have a domain?",
    answer:
      "We connect the domain you already own to the website and to your business email. A new domain can be registered during setup when you need one.",
  },
  {
    question: "What if I add more services or locations?",
    answer:
      "Essential covers one main location and your core service information. Several services or locations, each with its own page, are what the Professional Website is for.",
  },
  {
    question: "Is booking, a shop, or custom software included?",
    answer:
      "Both packages are enquiry websites. Online booking, ecommerce and bespoke systems are quoted separately.",
  },
];
---

<BaseLayout title="Website services" description={description}>
  <PageHero eyebrow="Built by Webco Media" title="Two websites. A clear choice.">
    <p>
      Essential suits a smaller business with one main location. Professional is for several services or locations.
    </p>
  </PageHero>

  <section class="section" aria-labelledby="offers-heading">
    <div class="wrap">
      <h2 id="offers-heading" class="visually-hidden">Website packages</h2>
      <div class="cards cards-2">
        {
          websiteOffers.map((offer) => (
            <article class="card offer-card" id={offer.id}>
              <figure class="website-preview">
                <img
                  src={offer.previewImage}
                  alt={`Preview of the ${offer.name} starting design`}
                  width="1280"
                  height="800"
                  onerror="this.closest('figure').hidden = true"
                />
              </figure>
              <p class="eyebrow">{offer.audience}</p>
              <h3>{offer.name}</h3>
              <p class="price">{offer.price}</p>
              <p>{offer.summary}</p>
              <ul class="offer-points">
                {offer.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <p class="offer-note">
                This demo is a starting design. Your finished website is customised for your business, not delivered as an unchanged template.
              </p>
              <div class="actions">
                <a class="button button-quiet" href={offer.demoUrl} target="_blank" rel="noopener noreferrer">
                  View live demo
                </a>
                <a class="button" href={`/start/?package=${offer.startPackage}`}>Choose this website</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="example-essential" aria-labelledby="example-essential-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{offers.essential.name}</p>
        <h2 id="example-essential-heading">A smaller business, one location</h2>
      </div>
      <p class="section-intro">
        The Essential example is a straightforward business site. Visitors see what you offer, the one location, and a clear way to call or send an enquiry. Key services stay on the core pages rather than each having a page of their own.
      </p>
      <div class="actions">
        <a class="button button-quiet" href={offers.essential.demoUrl} target="_blank" rel="noopener noreferrer">
          View the Essential live demo
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="example-training" aria-labelledby="example-training-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{offers.training.name}</p>
        <h2 id="example-training-heading">Several services and locations</h2>
      </div>
      <p class="section-intro">
        The Professional example gives each key service its own page and each location its own page. Someone searching locally can land on the right place, then follow that service through to an enquiry.
      </p>
      <div class="actions">
        <a class="button button-quiet" href={offers.training.demoUrl} target="_blank" rel="noopener noreferrer">
          View the Professional live demo
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-heading">Common questions</h2>
      </div>
      <ul class="qa">
        {
          questions.map((item) => (
            <li>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="One location, or several?"
    text="Choose Essential for a smaller setup. Choose Professional when services or locations need their own pages."
  >
    <a class="button" href="#essential">Essential Website</a>
    <a class="button button-quiet" href="#training">Professional Website</a>
  </CtaBand>
</BaseLayout>
